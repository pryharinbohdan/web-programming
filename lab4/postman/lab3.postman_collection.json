{
  "info": {
    "name": "Lab 3 — Catalog API",
    "description": "Лабораторна робота №3. Перевірки JSON API каталогу (успіх, валідація 422, 404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "known_slug",
      "value": ""
    },
    {
      "key": "category",
      "value": ""
    },
    {
      "key": "operation",
      "value": ""
    },
    {
      "key": "search",
      "value": ""
    }

              "  pm.expect(body.data).to.have.lengthOf(3);",
              "  pm.expect(body.links.prev).to.not.be.null;",
              "  const dates = body.data.map(p => p.published_at);",
              "  for (let i = 1; i < dates.length; i++) {",
              "    pm.expect(dates[i] <= dates[i - 1]).to.be.true;",
              "  }",
              "  pm.expect(body.data.map(p => p.slug)).to.not.include(pm.collectionVariables.get('known_slug'));",
              "});"
            ]
